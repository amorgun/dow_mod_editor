+## Fixed keeps the screen's ratio (data value, else the editor-data config
+## default) with visible overflow; responsive fills the parent.
+func set_fixed_ratio(fixed: bool) -> void:
+	if _default_ratio == 0.0:
+		_default_ratio = Settings.data.pload_lua("data:screen_editor.lua").get_value("aspect_ratio", 4.0 / 3, TYPE_FLOAT)
+	$RatioToggle.ratio = aspect_ratio if aspect_ratio > 0 else _default_ratio
+	$RatioToggle.fixed = fixed
+
+## All widgets whose HitArea contains the global point, top-most first.
+func widgets_at(point: Vector2) -> Array[Widget]:
+	var res: Array[Widget] = []
+	for c in widget_root.get_children():
+		if c is Widget:
+			_collect_hits(c, point, res)
+	res.reverse()
+	return res
+
+func _collect_hits(widget: Widget, point: Vector2, res: Array[Widget]) -> void:
+	if not widget.visible:
+		return
+	if widget.hit_test_global(point):
+		res.append(widget)
+	for slot_root in widget.slot_roots.values():
+		for type_root in slot_root.get_children():
+			for c in type_root.get_children():
+				if c is Widget:
+					_collect_hits(c, point, res)
+	for c in widget.children_root.get_children():
+		if c is Widget:
+			_collect_hits(c, point, res)
+
+func _set_hover(widget: Widget) -> void:
+	if _hover_widget == widget:
+		return
+	if is_instance_valid(_hover_widget) and _hover_widget.state != WIDGET_STATE.DISABLED:
+		_hover_widget.state = WIDGET_STATE.NORMAL
+	_hover_widget = widget
+	if widget != null and widget.state != WIDGET_STATE.DISABLED:
+		widget.state = WIDGET_STATE.HOVER
+
+func _gui_input(event: InputEvent) -> void:
+	if not is_interactive:
+		return
+	if event is InputEventMouseMotion:
+		var hits := widgets_at(get_global_mouse_position())
+		_set_hover(hits[0] if len(hits) else null)
+	elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
+		if is_instance_valid(_hover_widget) and _hover_widget.state != WIDGET_STATE.DISABLED:
+			_hover_widget.state = WIDGET_STATE.ACTIVE if event.pressed else WIDGET_STATE.HOVER
+
+func _on_mouse_exited() -> void:
+	if is_interactive:
+		_set_hover(null)
+
+func _ready() -> void:
+	mouse_exited.connect(_on_mouse_exited)
+	_box.resized.connect(_update_virtual_root)
+	_update_virtual_root()
+
+## Fonts and pixel sizes are authored for a constant viewport height: the
+## widgets render at that height and are scaled to fit the box.
+func _update_virtual_root() -> void:
+	if _virtual_height == 0.0 and Settings.data != null:
+		_virtual_height = Settings.data.pload_lua("data:screen_editor.lua").get_value("viewport_height", 768.0, TYPE_FLOAT)
+	if _box.size.y <= 0 or _virtual_height <= 0:
+		return
+	_virtual_root.size = Vector2(_box.size.x * _virtual_height / _box.size.y, _virtual_height)
+	_virtual_root.scale = Vector2.ONE * (_box.size.y / _virtual_height)
+
 func create_widget(parent: Widget = null) -> Widget:
 	var res := Widget.new()
+	# widgets are passive geometry: all mouse input is routed manually by UiScreen

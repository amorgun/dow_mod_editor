new file mode 100755
index 0000000..609b132
--- /dev/null
+++ b/togglable_aspect_ratio_container.gd
@@ -0,0 +1,40 @@
+## Two-root aspect toggle: content lives under $Free (responsive, parent-sized)
+## or $Fixed (an AspectRatioContainer with visible overflow); toggling `fixed`
+## reparents the content, keeping node identity. Hosts attach children under
+## $Free in their scenes.
+class_name TogglableAspectRatioContainer extends Control
+
+@export var ratio := 4.0 / 3:
+	set(val):
+		ratio = val
+		if is_node_ready():
+			$Fixed.ratio = val
+
+## Width-driven by default: content spans the full parent width and may
+## overflow vertically (visible overflow into the parent).
+@export var stretch_mode := AspectRatioContainer.STRETCH_WIDTH_CONTROLS_HEIGHT:
+	set(val):
+		stretch_mode = val
+		if is_node_ready():
+			$Fixed.stretch_mode = val
+
+@export var fixed := false:
+	set(val):
+		fixed = val
+		if is_node_ready():
+			_sync()
+
+var content_root: Control:
+	get: return $Fixed if fixed else $Free
+
+func _ready() -> void:
+	$Fixed.ratio = ratio
+	$Fixed.stretch_mode = stretch_mode
+	_sync()
+
+func _sync() -> void:
+	var target := content_root
+	var other: Control = $Free if fixed else $Fixed
+	for c in other.get_children():
+		other.remove_child(c)
+		target.add_child(c)
